# StoryMood backend configuration. Copy to .env and fill in the keys.

# ---- Provider selection (one word each; see providers/registry.py for the names) ----
LLM_PROVIDER=openai
TTS_PROVIDER=cartesia
STT_PROVIDER=openai
VIDEO_PROVIDER=none
MUSIC_PROVIDER=local
IMAGE_PROVIDER=openai  # page pictures: openai or none   # your own files in static/music, or none

# ---- OpenAI (story writing, speech-to-text, optional text-to-speech) ----
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-6.1-terra
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_TTS_MODEL=gpt-4o-mini-tts

# ---- Cartesia (text-to-speech, optional speech-to-text) ----
CARTESIA_API_KEY=
CARTESIA_TTS_MODEL=sonic-3.5
CARTESIA_STT_MODEL=ink-whisper

# ---- Story vault (DynamoDB). Leave blank to run without saving. ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
STORIES_TABLE=StoryArc_Stories
USERS_TABLE=StoryArc_Users

APP_ENV=development

# Sign-in: none = guests (local), cognito = Amazon Cognito (run scripts/setup_cognito.py to get these)
AUTH_MODE=none
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
COGNITO_GOOGLE=false
ALLOWED_ORIGINS=*
# Guardrails
MODERATION=openai
RATE_LIMITS=on

# Stories and files: local on a laptop; dynamodb + s3 in production
STORE_PROVIDER=local
FILES_PROVIDER=local
STORYMOOD_TABLE=StoryMood_Library
S3_BUCKET=
S3_PREFIX=storymood
FILES_PUBLIC_BASE=
FREE_STORIES=2
ADMIN_EMAILS=
